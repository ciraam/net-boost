{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetBoost",
  "version": "1.0.0",
  "identifier": "com.netboost.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run typecheck && npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetBoost — Tactical Telemetry & EU Router",
        "width": 1420,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#070A0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
